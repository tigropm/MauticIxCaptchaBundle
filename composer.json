{
    "name": "tgr-digital/mautic-ixcaptcha-bundle",
    "description": "GDPR-compliant Google reCAPTCHA v3 integration for Mautic 5, 6 and 7",
    "type": "mautic-plugin",
    "version": "1.0.0",
    "keywords": [
        "mautic",
        "plugin",
        "recaptcha",
        "captcha",
        "gdpr",
        "dsgvo",
        "spam-protection",
        "form"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "TGR Digital",
            "email": "info@tgr-digital.de",
            "homepage": "https://tgr-digital.de"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/http-client-contracts": "^2.5 || ^3.0"
    },
    "suggest": {
        "symfony/http-client": "Required for making HTTP requests to the Google reCAPTCHA API (already bundled with Mautic 5+)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\MauticIxCaptchaBundle\\": ""
        }
    },
    "extra": {
        "mautic": {
            "min-version": "5.0.0"
        }
    },
    "support": {
        "issues": "https://github.com/tgr-digital/mautic-ixcaptcha-bundle/issues",
        "source": "https://github.com/tgr-digital/mautic-ixcaptcha-bundle"
    }
}
